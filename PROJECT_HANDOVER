│   ├── Payment.h           # Receipt generator
│   ├── RideManager.h       # The "Brain" of the project - holds all data in memory
│   └── Exceptions.h        # Custom error types (e.g., InvalidOperationException)
│
├── src/                    # Source files (.cpp) - Actual logic and implementations
│   ├── User.cpp, Rider.cpp, Driver.cpp
