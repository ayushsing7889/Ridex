│   ├── Ride.cpp, Payment.cpp, RideManager.cpp
│   └── main.cpp            # Terminal menus and input loops
│
├── data/                   # Flat-file database (CSV files)
│   ├── riders.csv          # Saved riders
│   ├── drivers.csv         # Saved drivers & vehicles
│   └── rides.csv           # Saved trip records
│
├── build.bat               # 1-Click compiler script for Windows
├── README.md               # Main project presentation & interview Q&A
└── PROJECT_HANDOVER.md     # This document!
```

